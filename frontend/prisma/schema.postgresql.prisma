model AttackChain {
  id               String      @id @default(cuid())
  threatModelId    String
  threatModel      ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)
  name             String
  description      String
  severity         Severity
  residualSeverity Severity?
  likelihood       Float?
  status           ChainStatus @default(AI_SUGGESTED)
  sessionId        String
  entryPointId     String
