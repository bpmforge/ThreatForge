# ThreatForge Server Environment Variables

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database — provider auto-detected from the URL scheme (file: → SQLite).
# SQLite is the zero-setup local default and matches the checked-in Prisma schema.
DATABASE_URL="file:./prisma/dev.db"
# For PostgreSQL (production): DATABASE_URL="postgresql://postgres:postgres@localhost:5432/threatforge?schema=public"

# Encryption key for secrets at rest (org AI keys, integration tokens). REQUIRED in
# production; if unset in dev a random key is generated per-process, so encrypted
# data is unreadable after a restart. Generate: openssl rand -base64 32
# (must be base64 of 32 bytes — a hex string is rejected).
ENCRYPTION_KEY=
# Bearer token for GET /metrics and /health/dependencies (both 404 while unset).
# Generate: openssl rand -hex 32
METRICS_TOKEN=
# Field-level encryption of threat-model content (canvas, threats, mitigations,
# documents). Off by default for local dev; docker-compose.prod.yml turns it ON
# and requires ENCRYPTION_KEY. The server refuses to boot if this is true and
# ENCRYPTION_KEY is missing/invalid.
ENCRYPT_AT_REST=false

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production

# Setup Security (optional)
# Require a token for initial setup in production
# Generate with: openssl rand -hex 32
# SETUP_TOKEN=

# CORS
CORS_ORIGIN=http://localhost:3000

# Embedding (citation verifier — semantic pre-check)
# Any OpenAI-compatible /embeddings endpoint. LM Studio is the default.
AI_EMBEDDING_BASE_URL=http://localhost:1234/v1
AI_EMBEDDING_MODEL=nomic-embed-text
# AI_EMBEDDING_MAX_CHARS=2000   # max chars of section text sent for embedding
# AI_EMBEDDING_THRESHOLD=0.6    # cosine similarity threshold (0–1)

# Self-hosted AI on a private network (LM Studio, Ollama, ...): org AI settings
# may use a loopback/LAN base URL only if its host is allowlisted here or by a
# super-admin (Admin > Settings > Security). Comma-separated hostnames/IPs/CIDRs.
# AI_PRIVATE_HOST_ALLOWLIST=127.0.0.1,localhost,192.168.1.0/24
# Single-tenant installs only: allow every private host.
# AI_ALLOW_ALL_PRIVATE_HOSTS=false

# Accounts that may sign in and read but never change anything (public demo).
# DEMO_READONLY_USER_EMAILS=demo@example.com
