{
  "name": "threatforge-server",
  "version": "1.1.0",
  "description": "Backend API for ThreatForge",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest --exclude='**/*.integration.test.ts'",
    "test:integration": "vitest run --include='**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --max-warnings 251 --report-unused-disable-directives",
    "lint:fix": "eslint src/ --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "admin:rotate-password": "tsx src/scripts/rotate-user-password.ts",
    "parity:run": "tsx scripts/parity-run.ts",
    "eval:run": "tsx scripts/eval-run.ts",
    "eval:dupes": "tsx scripts/eval-dupes.ts",
    "parity:spot-check": "tsx scripts/spot-check-parity.ts",
    "bench:fanout": "tsx scripts/bench-fanout.ts",
    "seed:pipelines": "tsx scripts/seed-pipelines.ts",
    "seed:collab-user": "tsx src/scripts/seed-collab-user.ts",
    "setup:cli": "tsx src/scripts/setup-cli.ts",
    "docs:routes": "tsx scripts/generate-api-docs.ts"
  },
  "keywords": [
    "threat-modeling",
    "security",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.8.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.72.1",
    "docx": "^9.9.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.7.2",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.8.2",
    "lib0": "^0.2.114",
    "mammoth": "^1.12.0",
    "nodemailer": "^10.0.16",
    "otplib": "^12.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "qrcode": "^1.5.4",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@prisma/adapter-better-sqlite3": "^7.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/coverage-v8": "^4.0.14",
    "better-sqlite3": "^12.4.6",
    "eslint": "^9.39.1",
    "jszip": "^3.10.2",
    "pino-pretty": "^13.1.2",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "find-my-way": "9.7.0",
    "ws": "8.21.3",
    "nanoid": "5.1.16",
    "hono": "4.13.2",
    "brace-expansion": "5.0.12"
  }
}
