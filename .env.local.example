# =============================================================================
# ThreatForge - Local Development Environment Configuration
# =============================================================================
#
# Copy this file to .env.local and customize as needed:
#   cp .env.local.example .env.local
#
# Then start the stack:
#   podman-compose -f docker-compose.local.yml up -d
#
# For AI features (Ollama):
#   podman-compose -f docker-compose.local.yml --profile ai up -d
#
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
TZ=UTC
NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=flowthreat
POSTGRES_PASSWORD=flowthreat_dev
POSTGRES_DB=flowthreat
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
# Leave blank for no password (development only)
REDIS_PASSWORD=
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Security Keys
# -----------------------------------------------------------------------------
# IMPORTANT: Change these in production!
# Generate with: openssl rand -base64 32

# JWT signing key for API authentication
JWT_SECRET=dev-jwt-secret-change-this-in-production-use-openssl

# Encryption key for sensitive data (API keys, secrets)
# Must be exactly 32 characters
ENCRYPTION_KEY=dev-encryption-key-32-chars-ok!

# Auth.js session encryption
AUTH_SECRET=dev-auth-secret-change-this-in-production-use-openssl

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Frontend URL (where users access the app)
AUTH_URL=http://localhost:3000

# API URL (frontend -> backend communication)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# CORS allowed origin
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
# Change these if you have conflicts with other services
FRONTEND_PORT=3000
SERVER_PORT=3001

# -----------------------------------------------------------------------------
# AI Provider Configuration (Optional)
# -----------------------------------------------------------------------------
# Anthropic Claude - Best for threat analysis
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI - Alternative AI provider
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama - Local LLM (no API key needed)
# Runs inside the container when using --profile ai
OLLAMA_BASE_URL=http://ollama:11434

# Default model for Ollama (will be pulled on first use)
OLLAMA_MODEL=llama3.2

# LM Studio - Local LLM with OpenAI-compatible API
# Download from: https://lmstudio.ai/
# 1. Load a model in LM Studio
# 2. Start the local server (default port 1234)
# 3. Set the URL below (use host.containers.internal for container access)
LMSTUDIO_BASE_URL=http://host.containers.internal:1234/v1
LMSTUDIO_MODEL=local-model

# -----------------------------------------------------------------------------
# OAuth Providers (Optional)
# -----------------------------------------------------------------------------
# GitHub OAuth
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft/Azure AD OAuth
# Create at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Enable verbose Prisma query logging
# DEBUG=prisma:query

# Enable React Query devtools
# NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Skip email verification (development only)
# SKIP_EMAIL_VERIFICATION=true
