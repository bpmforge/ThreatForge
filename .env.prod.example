# Production Environment Configuration
# Copy to .env.prod and fill in your values
#
# Quick setup:
#   cp .env.prod.example .env.prod
#   # Edit values below
#   docker compose -f docker-compose.prod.yml up -d

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Domain name (no https://, just the domain)
DOMAIN=flowthreat.example.com

# Database credentials (use strong, unique passwords!)
POSTGRES_USER=flowthreat
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=flowthreat_prod

# Security secrets (generate with: openssl rand -base64 32)
JWT_SECRET=GENERATE_ME_WITH_OPENSSL
AUTH_SECRET=GENERATE_ME_WITH_OPENSSL

# Field-level encryption at rest (ON by default in docker-compose.prod.yml).
# REQUIRED: compose refuses to start without it. Must be base64 of 32 bytes.
#   openssl rand -base64 32
# BACK THIS UP - losing it makes encrypted data unrecoverable.
ENCRYPTION_KEY=GENERATE_ME_WITH_OPENSSL
# ENCRYPT_AT_REST=true   # default true; false is an explicit opt-out

# First system admin, created by the one-shot `init` service (idempotent).
INITIAL_SYSTEM_ADMIN_EMAIL=admin@example.com
INITIAL_SYSTEM_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Image version tag (for deployments)
# VERSION=latest

# UI Options
# SKIP_LANDING_PAGE=true  # Skip landing page, go directly to login (for self-hosted)

# AI Provider - uncomment ONE provider
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# OAuth Providers (for SSO login)
# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID (Azure AD) - for enterprise M365 customers
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common  # Use 'common' for multi-tenant, or specific tenant ID
# GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Apple Sign-In
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# SAML SSO via BoxyHQ Jackson (optional; add -f docker-compose.saml.yml)
# JACKSON_EXTERNAL_URL=https://jackson.example.com
# JACKSON_NEXTAUTH_SECRET=   # openssl rand -base64 32
# JACKSON_API_KEYS=          # openssl rand -hex 32
# AUTH_BOXYHQ_SAML_ISSUER=https://jackson.example.com
# AUTH_BOXYHQ_SAML_ID=tenant=<tenant>&product=<product>
# AUTH_BOXYHQ_SAML_SECRET=

# Email (for password reset, notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# Redis (for real-time collaboration - optional)
# REDIS_URL=redis://redis:6379

# Self-hosted AI on a private network (LM Studio, Ollama, ...): org AI settings
# may use a loopback/LAN base URL only if its host is allowlisted here or by a
# super-admin (Admin > Settings > Security). Comma-separated hostnames/IPs/CIDRs.
# AI_PRIVATE_HOST_ALLOWLIST=127.0.0.1,localhost,192.168.1.0/24
# Single-tenant installs only: allow every private host.
# AI_ALLOW_ALL_PRIVATE_HOSTS=false

# Accounts that may sign in and read but never change anything (public demo).
# DEMO_READONLY_USER_EMAILS=demo@example.com
