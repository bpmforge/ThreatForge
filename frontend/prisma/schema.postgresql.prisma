model AttackChainHop {
  id            String      @id @default(cuid())
  chainId       String
  chain         AttackChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  position      Int
  componentId   String
  componentName String
  connectionId  String?
  threatId      String?
  description   String
  technique     String?
  isMitigated   Boolean     @default(false)
  mitigationIds String      @default("[]")
  // Capability tokens (ARCHITECTURE §2.5). Stored as JSON-encoded string arrays
  // because the datasource is SQLite (dev/desktop), which has no native String[].
  // This mirrors the existing `mitigationIds` precedent and every other array-ish
  // field in the schema (e.g. 17-scanners cweIds/cveIds, 22-prompts variables).
  // The app boundary validates these as z.array(z.string()) and (de)serializes JSON.
  preconditions String     @default("[]")
  yields        String     @default("[]")

  @@index([chainId])
  @@map("attack_chain_hops")
}

