// =============================================================================
// From: 25-requirements.prisma
// =============================================================================

enum RequirementSource {
  MANUAL       // Added directly via UI
  DOCUMENT     // Extracted from an imported SRS/SAD/policy document
  CSV          // Bulk-imported via CSV upload
  FRAMEWORK    // Imported from a compliance framework (HIPAA, PCI-DSS, etc.)
  AI_SUGGESTED // LLM proposed this requirement to close a gap (awaits user review)
}

/// Review status for AI_SUGGESTED requirements (parallels Threat.reviewStatus).
/// MANUAL / DOCUMENT / CSV / FRAMEWORK sources default to ACCEPTED (no review needed).
enum RequirementReviewStatus {
  PENDING   // AI suggestion awaiting human review
  ACCEPTED  // Accepted into the requirements set
  REJECTED  // Rejected — kept as history but excluded from traceability
  MODIFIED  // Accepted with edits
}

model Requirement {
  id String @id @default(cuid())

  /// Short identifier: "FR-12", "SEC-3", "HIPAA-164.312(a)(1)", "REQ-001"
  reqId String

  /// Full requirement text
  text String

  /// Logical category: "security" | "functional" | "compliance" | "privacy" | "performance"
  category String?

  /// Source document label: "SRS", "SAD", "HIPAA", "PCI-DSS", user-supplied
  docId String?

  /// How this requirement entered the system
  source RequirementSource @default(MANUAL)

  /// Review lifecycle — only meaningful for AI_SUGGESTED (others default ACCEPTED)
  reviewStatus  RequirementReviewStatus @default(ACCEPTED)
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNotes   String?

  /// For FRAMEWORK source: the framework key (e.g. "HIPAA", "PCI_DSS")
  frameworkId String?

  /// Source document (when imported from a document)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId String?

  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)
  threatModelId String

  /// Groups versions of the same logical requirement across re-extractions. First version: familyId == id.
  requirementFamilyId String?

  /// Monotonic per-family version. v1, v2, v3 …
  version Int @default(1)

  /// Set when superseded by a newer version (e.g. re-extraction from a newer Document version).
  supersededAt DateTime?

  mitigations MitigationRequirement[]
  citations   Citation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  @@unique([threatModelId, reqId, version])
  @@index([threatModelId])
  @@index([threatModelId, supersededAt])
  @@index([requirementFamilyId])
  @@index([source])
  @@map("requirements")
}

/// Junction table: many-to-many between Mitigation and Requirement
model MitigationRequirement {
  id            String      @id @default(cuid())
  mitigation    Mitigation  @relation(fields: [mitigationId], references: [id], onDelete: Cascade)
  mitigationId  String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  requirementId String
  createdAt     DateTime    @default(now())

  @@unique([mitigationId, requirementId])
  @@index([mitigationId])
  @@index([requirementId])
  @@map("mitigation_requirements")
}

// =============================================================================
// From: 26-documents.prisma
// =============================================================================

enum DocumentType {
  PDF
  DOCX
  MARKDOWN
  TERRAFORM
  DOCKER_COMPOSE
  OPENAPI
  YAML
  TEXT
  SOURCE_CODE
}

model Document {
  id String @id @default(cuid())

  /// Original filename
  name String

  /// Document type
  type DocumentType

  /// File size in bytes (of original upload)
  sizeBytes Int @default(0)

  /// Estimated page count (for PDFs/DOCX)
  pageCount Int?

  /// Full extracted text content
  content String

  /// Whether the content was truncated (large documents)
  contentTruncated Boolean @default(false)

  /// sha256 of content — short-circuits no-op re-uploads and anchors citations to an immutable snapshot.
  contentHash String @default("")

  /// Groups all versions of the same logical document. First version: familyId == id.
  documentFamilyId String @default("")

  /// Monotonic per-family version. v1, v2, v3 …
  version Int @default(1)

  /// Set to the time this version was superseded by a newer upload. null = current.
  supersededAt DateTime?

  /// When AI extraction was last run on this document
  extractedAt DateTime?

  /// Summary/description of what was extracted
  extractionSummary String?

  /// Number of components extracted from this document
  extractedComponentCount Int @default(0)

  /// Number of requirements extracted from this document
  extractedRequirementCount Int @default(0)

  /// Parent threat model
  threatModel   ThreatModel @relation(fields: [threatModelId], references: [id], onDelete: Cascade)
  threatModelId String

  /// User who imported this document
  importedBy   User   @relation("DocumentImporter", fields: [importedById], references: [id])
  importedById String

  /// Requirements extracted from this document
  requirements Requirement[]

  /// Detected sections (used as citation anchors)
  sections DocumentSection[]

  /// Citations that point at this document
  citations Citation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threatModelId])
  @@index([threatModelId, supersededAt])
  @@index([documentFamilyId, version])
  @@index([importedById])
  @@map("documents")
}

// =============================================================================
// From: 27-citations.prisma
// =============================================================================

enum CitationKind {
  DERIVED // Direct claim from source — must verify, must match
  INFERRED // Extrapolation from source — must verify source exists, semantic match optional
  NOT_FOUND // LLM explicitly flagged absent — no verification, surfaces as a known gap
  NONE // No citation provided — auto-marked unverified
}

enum CitationType {
  DOCUMENT // Cited section / page of an imported Document
  REFERENCE // CWE / OWASP / compliance clause
  COMPONENT // Canvas component or boundary
  REQUIREMENT // Imported requirement (SRS/SAD reqId)
  NONE
}

enum VerificationStatus {
  PENDING // Queued for verification or not yet processed
  VERIFIED // Cross-check passed
  UNVERIFIED // Cross-check ran but the source did not support the claim
  PHANTOM // Citation resolves to nothing (doc / section / id not found)
  EXEMPT // Surface is exempt from verification
}

model Citation {
  id String @id @default(cuid())

  // Classification
  kind         CitationKind
  citationType CitationType

  // DOCUMENT citation fields (set when citationType = DOCUMENT)
  documentId String?
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sectionId  String?
  section    DocumentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  pageNumber Int?
  excerpt    String? // Up to ~500 chars of the supporting text

  // REFERENCE citation fields (set when citationType = REFERENCE)
  referenceKind String? // "CWE" | "OWASP" | "NIST_800_53" | "HIPAA" | etc.
  referenceId   String? // "CWE-89" | "A03:2021" | "SC-7" | etc.

  // COMPONENT citation fields (set when citationType = COMPONENT)
  componentNodeId String? // React Flow node id

  // REQUIREMENT citation fields (set when citationType = REQUIREMENT)
  requirementId String? // FK into Requirement
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  // Verification result
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifierConfidence Float? // 0.0 - 1.0
  verifierRationale  String?
  verifierProvider   String? // Which AI provider ran the cross-check

  // Human override (set when a reviewer accepts/rejects a PHANTOM or UNVERIFIED citation)
  overriddenById    String?
  overrideRationale String?
  overriddenAt      DateTime?

  // Ownership — exactly one of threatId / mitigationId set (XOR enforced in service)
  threatId     String?
  threat       Threat?     @relation(fields: [threatId], references: [id], onDelete: Cascade)
  mitigationId String?
  mitigation   Mitigation? @relation(fields: [mitigationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threatId])
  @@index([mitigationId])
  @@index([documentId, sectionId])
  @@index([verificationStatus])
  @@map("citations")
}

model DocumentSection {
  id String @id @default(cuid())

  /// Parent document
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Stable anchor — used in citation tags, e.g. "3.2", "appendix-a", "system-overview"
  anchor String

  /// Human-readable heading text as detected
  header String

  /// Page number if known (PDF), null otherwise
  pageNumber Int?

  /// Char offsets into Document.content
  startOffset Int
  endOffset   Int

  /// Embedding vector stored as packed Float32 bytes (4 bytes per dimension).
  /// Null until the embedding job runs after document import.
  /// On SQLite (dev) this is always null — fail-open: semantic pre-check skipped.
  embedding Bytes?

  citations Citation[]

  createdAt DateTime @default(now())

  @@unique([documentId, anchor])
  @@index([documentId])
  @@map("document_sections")
}

