# Database Configuration
POSTGRES_USER=flowuser
POSTGRES_PASSWORD=flowpass
POSTGRES_DB=flowthreat

# First system admin, created by the one-shot `init` service on `docker compose up`.
# Use a real password of 12+ characters: init refuses published placeholders such
# as "ChangeMe123x", and the stack does not start until init succeeds.
# ./scripts/demo.sh fills in a random password if this is left empty. With
# plain `docker compose up` and no password, no admin is created and the
# first-run setup wizard asks for one instead.
INITIAL_SYSTEM_ADMIN_EMAIL=admin@example.com
INITIAL_SYSTEM_ADMIN_PASSWORD=

# Field-level encryption at rest. Off for the quickstart stack; to enable:
#   ENCRYPT_AT_REST=true and ENCRYPTION_KEY=$(openssl rand -base64 32)
# (docker-compose.prod.yml enables it by default and requires the key.)
# ENCRYPT_AT_REST=false
# ENCRYPTION_KEY=

# Optional SAML SSO via BoxyHQ Jackson: add -f docker-compose.saml.yml
# JACKSON_EXTERNAL_URL=http://localhost:5225
# JACKSON_NEXTAUTH_SECRET=
# JACKSON_API_KEYS=
# AUTH_BOXYHQ_SAML_ISSUER=http://localhost:5225

# Server Configuration
# Generate each with: openssl rand -base64 32
JWT_SECRET=
AUTH_SECRET=
CORS_ORIGIN=http://localhost:3000
# Proxy addresses allowed to set the client IP (X-Forwarded-For); "false" trusts none
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# AI Provider Configuration (optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# Self-hosted AI on a private network (LM Studio, Ollama, ...): org AI settings
# may use a loopback/LAN base URL only if its host is allowlisted here or by a
# super-admin (Admin > Settings > Security). Comma-separated hostnames/IPs/CIDRs.
# AI_PRIVATE_HOST_ALLOWLIST=127.0.0.1,localhost,192.168.1.0/24
# Single-tenant installs only: allow every private host.
# AI_ALLOW_ALL_PRIVATE_HOSTS=false

# Accounts that may sign in and read but never change anything (public demo).
# DEMO_READONLY_USER_EMAILS=demo@example.com
