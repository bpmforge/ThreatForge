// =============================================================================
// Threat & Mitigation Models
// =============================================================================

model Threat {
  id                 String       @id @default(cuid())
  name               String
  description        String?
  strideCategories   String       @default("[]")
  severity           Severity     @default(MEDIUM)
  status             ThreatStatus @default(OPEN)
  category           String?
  complianceControls String       @default("{}")
  cweIds             String       @default("[]")
  owaspIds           String       @default("[]")
  templateId         String?
  assigneeId         String?

  threatModel      ThreatModel     @relation(fields: [threatModelId], references: [id], onDelete: Cascade)
  threatModelId    String
  componentNodeId  String?
  connectionEdgeId String?
  template         ThreatTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignee         User?           @relation("ThreatAssignee", fields: [assigneeId], references: [id])

  mitigations Mitigation[]
  riskScores  ThreatRiskScore[]
  comments    ThreatComment[]

  // Claim-citation verifier (rollup from Citation rows; computed on write)
  citations          Citation[]
  verificationStatus VerificationStatus @default(PENDING)

  // Challenger gate (A4-1, ARCHITECTURE §2.4) — adversarial-refutation verdict.
  // Distinct from `verificationStatus` above, which is the citation-rollup
  // field owned by the citation verifier. UNVERIFIED = not yet challenged;
  // CONFIRMED = survived refutation; UNCERTAIN = kept but flagged (low-conf
  // refute / topology-or-citation doubt). REFUTED-with-confidence rows are
  // deleted, never persisted with a status.
  challengeStatus  ChallengeStatus @default(UNVERIFIED)
  verificationNote String?

  // AI/Human provenance
  source       ThreatSource @default(MANUAL)
  reviewStatus ReviewStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?

  // CVSS scoring (persisted, not just calculated on-the-fly)
  cvssVector31 String? // "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"
  cvssScore31  Float? // 0.0-10.0
  cvssVector40 String? // "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/..."
  cvssScore40  Float? // 0.0-10.0

  // AI metadata (from micro-analysis pipeline)
  aiConfidence   Float? // 0.0-1.0 confidence from analysis
  aiMethodology  String? // "stride", "pasta", "kill_chain", "compound"
  attackVector   String? // Step-by-step attack scenario
  residualRisk   String? // What risk remains after mitigation
  evidence       String? // JSON: {owasp, cwe, compliance, attackPath}
  analysisHash   String? // Hash of the component at time this threat was generated
  manuallyEdited Boolean @default(false) // True once a human has saved any edit. AI will skip on re-run.

  // Analysis session provenance — set to aiJob.id of the run that created
  // this threat. Lets the startup sweeper and failure-cleanup hooks delete
  // partial-run rows atomically without affecting human-reviewed threats.
  analysisSessionId String?

  // Paraphrase-normalized name for the DB unique constraint. Computed from
  // `name` via normalizeThreatName() on every write. See
  // migrations/add-threat-dedup for the targetKey composition.
  normalizedName String?

  // W-03 (R12) — set when T3.2 LLM dedup (llm-dedup.ts) collapsed this row
  // into a canonical duplicate elsewhere in the same analysis session. Holds
  // the id of the surviving Threat row (best-effort target-scoped
  // attribution; plain string, no FK, so a later delete of the winner can't
  // orphan-constrain this row). Null = not superseded. Losers are MARKED,
  // never deleted, so a human reviewer can still recover one.
  dedupSupersededById String?

  // Business context risk scoring (A23)
  likelihood        Float?     // 0.0–1.0; null = not set by user
  businessRiskScore Float?     // computed score 0–30; null if BusinessContext not configured
  businessRiskTier  RiskTier?  // LOW/MEDIUM/HIGH/CRITICAL; derived from businessRiskScore

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  @@index([threatModelId])
  @@index([threatModelId, reviewStatus])
  @@index([componentNodeId])
  @@index([connectionEdgeId])
  @@index([status])
  @@index([severity])
  @@index([source])
  @@index([reviewStatus])
  @@index([verificationStatus])
  @@index([challengeStatus])
  @@index([analysisSessionId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([dedupSupersededById])
  @@map("threats")
}

enum ThreatSource {
  MANUAL // Created by human
  AI_SUGGESTED // Generated by AI, pending review
  AI_ACCEPTED // AI-generated, accepted by human
  AI_MODIFIED // AI-generated, modified by human
}

enum ReviewStatus {
  PENDING // Not yet reviewed
  ACCEPTED // Reviewer confirmed finding
  REJECTED // Reviewer marked as false positive
  MODIFIED // Reviewer changed details
}

// Challenger-gate verdict (A4-1, ARCHITECTURE §2.4). Adversarial refutation
// outcome retained on a kept threat. REFUTED is intentionally absent: a
// confidently-refuted AI_SUGGESTED threat is deleted, not flagged.
enum ChallengeStatus {
  UNVERIFIED // Not yet run through the challenger gate
  CONFIRMED // Survived topology + citation + adversarial refutation
  UNCERTAIN // Kept, but flagged (low-confidence refute or unresolved doubt)
}

enum StrideCategory {
  SPOOFING
  TAMPERING
  REPUDIATION
  INFORMATION_DISCLOSURE
  DENIAL_OF_SERVICE
  ELEVATION_OF_PRIVILEGE
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum ThreatStatus {
  OPEN
  MITIGATED
  ACCEPTED
  NOT_APPLICABLE
}

// Business context risk tier — derived from computed businessRiskScore (0–30)
// Boundaries: 0–7 = LOW, 7–14 = MEDIUM, 14–21 = HIGH, 21–30 = CRITICAL
enum RiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Mitigation {
  id                  String               @id @default(cuid())
  description         String // High-level control: "Implement IAM controls for service auth"
  status              MitigationStatus     @default(NOT_IMPLEMENTED)
  priority            Priority             @default(MEDIUM)
  strategy            MitigationStrategy   @default(PREVENTION)
  controlCategory     String? // IAM|ENCRYPTION|ACCESS_CONTROL|NETWORK|LOGGING|INPUT_VALIDATION|SECRETS|BACKUP|MONITORING|SUPPLY_CHAIN
  notes               String?
  dueDate             DateTime?
  effectivenessScore  Float? // 0.0-0.85 — capped, never 100%
  implementationNotes String? // What was actually done (human fills in)
  verified            Boolean              @default(false) // True when implementation has been verified
  obligation          MitigationObligation @default(RECOMMENDED)

  // Testability — VNV can verify this mitigation
  testCriteria String? // "Confirm that all service calls use mTLS certificates"
  testResult   String? // "PASS"|"FAIL"|"PARTIAL" + notes
  testedById   String?
  testedAt     DateTime?

  // Evidence/Proof — links to tickets, docs, screenshots, scan results
  evidenceLinks String @default("[]") // JSON: [{type:"ticket",url:"...",title:"JIRA-123"}]

  // Requirement Traceability — links to SRS/SAD requirements
  // Legacy JSON field kept during migration; use MitigationRequirement junction going forward
  requirementRefs String @default("[]") // JSON: [{docId:"SRS-9876543",reqId:"FR-12",text:"TLS 1.3"}]

  // Normalized requirement links (replaces requirementRefs JSON)
  requirements MitigationRequirement[]

  // Control Inheritance — shared controls across models
  isSharedControl    Boolean @default(false) // Can be inherited by other models in the org
  inheritedFromId    String? // ID of the source mitigation this was inherited from
  inheritedFromModel String? // Name of the model the source belongs to

  // Claim-citation verifier (rollup from Citation rows)
  citations          Citation[]
  verificationStatus VerificationStatus @default(PENDING)

  // D2: who owns this row. Only AI rows are regenerable, so only AI rows may be
  // cleared by an AI re-analysis (see review-service persistAIThreats). Defaults
  // to HUMAN so a row written by any path that forgets to set it is preserved
  // rather than silently deleted on the next rerun.
  source MitigationSource @default(HUMAN)

  threat     Threat  @relation(fields: [threatId], references: [id], onDelete: Cascade)
  threatId   String
  assignee   User?   @relation("MitigationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  @@index([threatId])
  @@index([status])
  @@index([verificationStatus])
  @@index([assigneeId])
  @@index([inheritedFromId])
  @@index([createdById])
  @@map("mitigations")
}

enum MitigationStatus {
  NOT_IMPLEMENTED
  IMPLEMENTED
}

/// Whether a mitigation was generated by the AI analysis pipeline (regenerable,
/// so an AI rerun may replace it) or came from anywhere else — hand-written,
/// template-instantiated, code-scan- or import-derived. HUMAN means "not owned
/// by the AI rerun", not "typed by a person".
enum MitigationSource {
  AI
  HUMAN
}

enum MitigationObligation {
  REQUIRED
  RECOMMENDED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MitigationStrategy {
  PREVENTION
  DETECTION
  RESPONSE
  RECOVERY
  DETERRENCE
}
