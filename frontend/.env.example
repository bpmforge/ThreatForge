# ThreatForge - Environment Configuration
# Copy this file to .env.local and configure for your environment

# =============================================================================
# Authentication (Auth.js / NextAuth)
# =============================================================================
# Generate a secure secret: openssl rand -base64 32
AUTH_SECRET=your-secret-key-change-in-production
AUTH_URL=http://localhost:3000

# =============================================================================
# Database Configuration
# =============================================================================
# Provider is auto-detected from URL scheme (file: = SQLite, postgresql: = PostgreSQL)
# This matches the backend detection logic for consistency.

# SQLite Configuration (local development)
# Use relative path from frontend directory to share database with backend
DATABASE_URL=file:../server/prisma/dev.db

# PostgreSQL Configuration (cloud deployment, enterprise)
# Uncomment for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/threatforge

# =============================================================================
# API Configuration
# =============================================================================
# Backend server URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# OAuth Providers (Optional)
# =============================================================================
# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Azure AD)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# =============================================================================
# SAML SSO (Enterprise)
# =============================================================================
# BoxyHQ Jackson SAML provider
# Self-host Jackson: https://boxyhq.com/docs/jackson/deploy
# Or use BoxyHQ Cloud: https://boxyhq.com
# AUTH_BOXYHQ_SAML_ID=tenant=<tenant>&product=<product>
# AUTH_BOXYHQ_SAML_SECRET=your-jackson-client-secret
# AUTH_BOXYHQ_SAML_ISSUER=https://your-jackson-instance.com
# Set to 'true' to show SSO option on login page
# NEXT_PUBLIC_SAML_ENABLED=true

# =============================================================================
# AI Configuration (Optional)
# =============================================================================
# Anthropic Claude
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Google Gemini
# GOOGLE_AI_API_KEY=

# Local Ollama (no API key required, just URL)
# OLLAMA_BASE_URL=http://localhost:11434
