  @@map("prompt_pipelines")
}

/// Stage within a pipeline
model PipelineStage {
  id          String  @id @default(cuid())
  name        String
  description String?

  order     Int    @default(0)
  dependsOn String @default("[]")

  promptTemplateId String
  inputMapping     String @default("{}")
  outputFields     String @default("[]")

  optional   Boolean @default(false)
  retryCount Int     @default(0)
  timeoutMs  Int?
  condition  String?

  pipeline        PromptPipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId      String
  stageExecutions PipelineStageExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@index([promptTemplateId])
  @@map("pipeline_stages")
}

/// Execution of an entire pipeline
model PipelineExecution {
  id String @id @default(cuid())

  pipeline   PromptPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String

  organizationId String?
  userId         String
  threatModelId  String?

  inputDocument   String?
  inputDocumentId String?
  inputMetadata   String  @default("{}")

  status         ExecutionStatus @default(PENDING)
  currentStageId String?
  outputs        String          @default("{}")
  finalResult    String?

  totalDurationMs Int?
  totalTokensUsed Int?

  errorMessage String?
  errorStageId String?

  stageExecutions PipelineStageExecution[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([pipelineId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("pipeline_executions")
}

/// Execution of a single stage within a pipeline
model PipelineStageExecution {
  id String @id @default(cuid())

  pipelineExecution   PipelineExecution @relation(fields: [pipelineExecutionId], references: [id], onDelete: Cascade)
  pipelineExecutionId String
  stage               PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId             String

  order  Int
  status ExecutionStatus @default(PENDING)

  input        String?
  output       String?
  outputParsed String?

  durationMs    Int?
  tokensUsed    Int?
  retryAttempts Int  @default(0)

  errorMessage String?
  errorCode    String?

  startedAt   DateTime?
  completedAt DateTime?

  @@unique([pipelineExecutionId, stageId])
  @@index([pipelineExecutionId])
  @@index([stageId])
  @@index([status])
  @@map("pipeline_stage_executions")
}

