# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.auth
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets should not be committed)
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Database files (not source data modules)
/data/
/prisma/dev.db*

# E2E test screenshots (all subdirectories)
e2e/screenshots/

# Backup / temp files
*.bak
*.orig
*.tmp

# Logs
*.log
logs/
