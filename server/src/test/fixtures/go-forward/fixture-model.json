  "sequenceDiagrams": [
    {
      "diagramName": "Checkout Flow",
      "messages": [
        {
          "from": "End User",
          "to": "Customer Web Portal",
          "label": "Submit checkout form",
          "protocol": "HTTPS",
          "authentication": "None"
        },
        {
          "from": "Customer Web Portal",
          "to": "API Gateway",
          "label": "POST /v1/orders",
          "protocol": "HTTPS",
          "authentication": "JWT"
        },
        {
          "from": "API Gateway",
          "to": "Core REST API",
          "label": "Forward order request",
          "protocol": "HTTPS",
          "authentication": "JWT"
        },
        {
          "from": "Core REST API",
          "to": "Auth Service",
          "label": "Verify access token",
          "protocol": "gRPC",
          "authentication": "mTLS"
        },
        {
          "from": "Core REST API",
          "to": "Order Service",
          "label": "Create order",
          "protocol": "gRPC",
          "authentication": "mTLS"
        },
        {
          "from": "Order Service",
          "to": "PostgreSQL Primary",
          "label": "INSERT order",
          "protocol": "PostgreSQL",
          "authentication": "Basic"
        },
        {
          "from": "Core REST API",
          "to": "Billing Service",
          "label": "Charge payment",
          "protocol": "gRPC",
          "authentication": "mTLS"
        },
        {
          "from": "Billing Service",
          "to": "Stripe Payment Gateway",
          "label": "Create charge (tokenized card)",
          "protocol": "HTTPS",
          "authentication": "API_KEY"
        },
        {
          "from": "Order Service",
          "to": "RabbitMQ Broker",
          "label": "Publish order-placed",
          "protocol": "AMQP",
          "authentication": "Basic",
          "notes": "Email worker consumes and calls SendGrid"
