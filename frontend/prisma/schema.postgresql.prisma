  // Guest access settings
  allowGuestAccess Boolean   @default(true)
  guestDefaultRole GuestRole @default(VIEWER)
  allowGuestExport Boolean   @default(false)

  // Quotas
  maxMembers          Int?
  maxProjects         Int?
  maxModelsPerProject Int?
